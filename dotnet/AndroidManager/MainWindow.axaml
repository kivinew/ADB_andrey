<Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:AndroidManager.Views"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="880"
             x:Class="AndroidManager.MainWindow"
             Title="Android manager"
             Width="1280" Height="880"
             MinWidth="900" MinHeight="600"
             Background="{DynamicResource Bg}">

  <Border CornerRadius="18" BorderBrush="{DynamicResource BorderDim}" BorderThickness="1" Background="{DynamicResource Bg}" Padding="0">

    <Grid RowDefinitions="Auto,1*">

      <!-- ===== Шапка ===== -->
      <Border Grid.Row="0" x:Name="TitleBar" Padding="24 16 24 12" Background="Transparent">
        <Grid ColumnDefinitions="1*,Auto">

          <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="ANDROID MANAGER" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent}" LetterSpacing="0.5" />
            <TextBlock x:Name="StatusLine" Text="СТАТУС: НЕ ПОДКЛЮЧЕНО" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource HeadText}" LetterSpacing="0.4" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="ВЕРСИЯ UI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                <TextBlock x:Name="UiVersion" Text="v1.22" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text}" HorizontalAlignment="Right" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="ЯДРО" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                <TextBlock x:Name="CoreVersion" Text="v1.2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource HeadText}" HorizontalAlignment="Right" />
              </StackPanel>

              <Button x:Name="HistoryBtn" Classes="icon-btn" ToolTip.Tip="История и обновления">
                <TextBlock Text="↻" FontSize="14" Foreground="#7B84A0" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Button>

              <Border Background="{DynamicResource BorderDim}" Width="1" Height="20" VerticalAlignment="Center" />

            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button x:Name="MinBtn" Classes="win-btn" ToolTip.Tip="Свернуть">
                <TextBlock Text="—" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Button>
              <Button x:Name="MaxBtn" Classes="win-btn" ToolTip.Tip="Развернуть">
                <TextBlock Text="□" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Button>
              <Button x:Name="CloseBtn" Classes="win-btn" ToolTip.Tip="Закрыть">
                <TextBlock Text="×" FontSize="14" FontWeight="Bold" Foreground="#FF6B8A" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Button>
            </StackPanel>
          </StackPanel>

        </Grid>
      </Border>

      <!-- ===== Тело: сайдбар + контент ===== -->
      <Grid Grid.Row="1" ColumnDefinitions="68,1*">

        <!-- Боковое меню -->
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" Padding="0,12,0,18">
          <Grid RowDefinitions="*,Auto">
            <StackPanel Grid.Row="0" Spacing="10" VerticalAlignment="Top" Margin="0,8,0,0">
              <Button x:Name="BtnHome" Classes="nav-btn is-active" ToolTip.Tip="Подключение">
                <Image Source="Icons/connect.png" Width="16" Height="16" Stretch="Uniform" />
              </Button>
              <Button x:Name="BtnCards" Classes="nav-btn" ToolTip.Tip="Система">
                <Image Source="Icons/widgets.png" Width="16" Height="16" Stretch="Uniform" />
              </Button>
              <Button x:Name="BtnApps" Classes="nav-btn" ToolTip.Tip="Приложения">
                <Image Source="Icons/apps.png" Width="16" Height="16" Stretch="Uniform" />
              </Button>
              <Button x:Name="BtnProcs" Classes="nav-btn" ToolTip.Tip="Процессы">
                <Image Source="Icons/process.png" Width="16" Height="16" Stretch="Uniform" />
              </Button>
              <Button x:Name="BtnConsole" Classes="nav-btn" ToolTip.Tip="Консоль">
                <Button.Content>
                  <Viewbox Width="20" Height="14" Stretch="Uniform">
                    <Path Width="14" Height="10" Fill="#7B84A0">
                      <Path.Data>
                        <PathGeometry FillRule="EvenOdd">
                          <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="14,0" />
                            <LineSegment Point="14,10" />
                            <LineSegment Point="0,10" />
                          </PathFigure>
                          <PathFigure StartPoint="1,1" IsClosed="True">
                            <LineSegment Point="1,8" />
                            <LineSegment Point="13,8" />
                            <LineSegment Point="13,1" />
                          </PathFigure>
                          <PathFigure StartPoint="2,2" IsClosed="True">
                            <LineSegment Point="4,2" />
                            <LineSegment Point="4,4" />
                            <LineSegment Point="2,4" />
                          </PathFigure>
                          <PathFigure StartPoint="5,7" IsClosed="True">
                            <LineSegment Point="10,7" />
                            <LineSegment Point="10,9" />
                            <LineSegment Point="5,9" />
                          </PathFigure>
                        </PathGeometry>
                      </Path.Data>
                    </Path>
                  </Viewbox>
                </Button.Content>
              </Button>
              <Button x:Name="BtnLogs" Classes="nav-btn" ToolTip.Tip="Логи">
                <Image Source="Icons/logs.png" Width="16" Height="16" Stretch="Uniform" />
              </Button>
              <Button x:Name="BtnActions" Classes="nav-btn" ToolTip.Tip="Действия">
                <!-- Векторная молния: растровая 16×16 в сайдбаре выглядела мыльной -->
                <Viewbox Width="20" Height="15" Stretch="Uniform">
                  <Path Width="9" Height="16" Fill="#7B84A0" Data="M5,0 L0,10 L4.5,10 L3,16 L9,6 L5,6 Z" />
                </Viewbox>
              </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Bottom">
              <Button x:Name="BtnSettings" Classes="nav-btn" ToolTip.Tip="Настройки">
                <TextBlock Text="⚙" FontSize="16" Foreground="#7B84A0" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="ContentGrid" RowDefinitions="Auto,*">

            <!-- Подключение -->
            <Border Classes="panel" x:Name="PanelConnection" IsVisible="True" Margin="32">
              <views:ConnectionView x:Name="ConnectionTab" />
            </Border>

            <!-- Консоль -->
            <Border Classes="panel" x:Name="PanelConsole" IsVisible="False" Margin="32">
              <views:ConsoleView x:Name="ConsoleTab" />
            </Border>

            <!-- Приложения -->
            <Border Classes="panel" x:Name="PanelApps" IsVisible="False" Margin="32">
              <views:AppsView x:Name="AppsTab" />
            </Border>

            <!-- Карточки -->
            <Border Classes="panel" x:Name="PanelCards" IsVisible="False" Margin="32">
              <views:CardsView x:Name="CardsTab" />
            </Border>

            <!-- Настройки -->
            <Border Classes="panel" x:Name="PanelSettings" IsVisible="False" Margin="32">
              <views:SettingsView x:Name="SettingsTab" />
            </Border>

            <!-- Процессы -->
            <Border Classes="panel" x:Name="PanelProcs" IsVisible="False" Margin="32">
              <views:ProcsView x:Name="ProcsTab" />
            </Border>

            <!-- Действия -->
            <Border Classes="panel" x:Name="PanelActions" IsVisible="False" Margin="32">
              <views:ActionsView x:Name="ActionsTab" />
            </Border>

            <!-- Логи -->
            <Border Classes="panel" x:Name="PanelLogs" IsVisible="False" Margin="32">
              <views:LogView x:Name="LogsTab" />
            </Border>

          </Grid>
        </ScrollViewer>

      </Grid>

    </Grid>

  </Border>
</Window>
