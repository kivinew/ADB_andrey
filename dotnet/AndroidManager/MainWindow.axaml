<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AndroidManager.Views"
        x:Class="AndroidManager.MainWindow"
        Title="Android manager"
        Width="1280" Height="880"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource Bg}">

  <Border CornerRadius="18" BorderBrush="{DynamicResource BorderDim}" BorderThickness="1" Background="{DynamicResource Bg}" Padding="0">

    <Grid RowDefinitions="Auto,1*">

      <!-- ===== Шапка ===== -->
      <Border Grid.Row="0" Padding="32 32 32 24" BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="1*,Auto">

          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="ANDROID MANAGER" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
            <TextBlock x:Name="StatusLine" Text="Статус: не подключено" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource HeadText}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Text="Версия UI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                <TextBlock x:Name="UiVersion" Text="v1.0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Ядро" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                <TextBlock x:Name="CoreVersion" Text="v1.0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" />
              </StackPanel>
            </StackPanel>

            <Border BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,1,0" Padding="0,6" Margin="0,0,16,0" VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="HistoryBtn" Classes="icon-btn" ToolTip.Tip="История и обновления">
                <PathIcon Data="M3 12a9 9 0 109-9 9 9 0 00-7 3L3 8M3 3v5h5M12 7v5l3 2" />
              </Button>
              <Button x:Name="MinBtn" Classes="icon-btn" ToolTip.Tip="Свернуть">
                <PathIcon Data="M5 12h14" />
              </Button>
              <Button x:Name="MaxBtn" Classes="icon-btn" ToolTip.Tip="Развернуть">
                <PathIcon Data="M5 5h14v14H5z" />
              </Button>
              <Button x:Name="CloseBtn" Classes="icon-btn" ToolTip.Tip="Закрыть">
                <PathIcon Data="M6 6l12 12M18 6L6 18" />
              </Button>
            </StackPanel>
          </StackPanel>

        </Grid>
      </Border>

      <!-- ===== Тело: сайдбар + контент ===== -->
      <Grid Grid.Row="1" ColumnDefinitions="76,1*">

        <!-- Боковое меню -->
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,1,0" Padding="0,12">
          <StackPanel Spacing="8" VerticalAlignment="Top" Margin="0,20">
            <Button x:Name="BtnHome" Classes="nav-btn is-active" ToolTip.Tip="Главная">
              <PathIcon Data="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10" />
            </Button>
            <Button x:Name="BtnStrategies" Classes="nav-btn" ToolTip.Tip="Стратегии">
              <PathIcon Data="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" />
            </Button>
            <Button x:Name="BtnSpeed" Classes="nav-btn" ToolTip.Tip="Скорость">
              <PathIcon Data="M13 2L4 14h7l-1 8 9-12h-7z" />
            </Button>
            <Button x:Name="BtnCloud" Classes="nav-btn" ToolTip.Tip="WARP">
              <PathIcon Data="M7 18a4 4 0 010-8 5 5 0 019.6-1A4.5 4.5 0 0117 18z" />
            </Button>
            <Button x:Name="BtnTelegram" Classes="nav-btn" ToolTip.Tip="Telegram">
              <PathIcon Data="M21 4L3 11l6 2 2 6 3-4 5 4z" />
            </Button>
            <Button x:Name="BtnStats" Classes="nav-btn" ToolTip.Tip="Статистика">
              <PathIcon Data="M3 20h18M5 20v-6M9 20v-9M13 20v-5M17 20V8M21 20V5" />
            </Button>
            <Rectangle Fill="{DynamicResource BorderDim}" Height="1" Margin="12,24,12,0" VerticalAlignment="Center" />
            <Button x:Name="BtnGithub" Classes="nav-btn" ToolTip.Tip="GitHub">
              <PathIcon Data="M9 19c-4 1-4-2-6-2m12 4v-3a3 3 0 00-1-2c3 0 6-2 6-6a5 5 0 00-1-3 5 5 0 000-3s-1-.3-3 1a10 10 0 00-6 0c-2-1.3-3-1-3-1a5 5 0 000 3 5 5 0 00-1 3c0 4 3 6 6 6a3 3 0 00-1 2v3" />
            </Button>
            <Button x:Name="BtnSettings" Classes="nav-btn" ToolTip.Tip="Настройки">
              <PathIcon Data="M19 12l2-1-2-4-2 1a7 7 0 00-2-1l-.5-2h-5L9 7a7 7 0 00-2 1l-2-1-2 4 2 1a7 7 0 000 2l-2 1 2 4 2-1a7 7 0 002 1l.5 2h5l.5-2a7 7 0 002-1l2 1 2-4-2-1a7 7 0 000-2z" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="ContentGrid" RowDefinitions="Auto,*">

            <!-- Подключение -->
            <Border Classes="panel" x:Name="PanelConnection" IsVisible="True" Margin="32">
              <views:ConnectionView x:Name="ConnectionTab" />
            </Border>

            <!-- Консоль -->
            <Border Classes="panel" x:Name="PanelConsole" IsVisible="False" Margin="32">
              <views:ConsoleView x:Name="ConsoleTab" />
            </Border>

            <!-- Приложения -->
            <Border Classes="panel" x:Name="PanelApps" IsVisible="False" Margin="32">
              <views:AppsView x:Name="AppsTab" />
            </Border>

            <!-- Карточки -->
            <Border Classes="panel" x:Name="PanelCards" IsVisible="False" Margin="32">
              <views:CardsView x:Name="CardsTab" />
            </Border>

            <!-- Настройки -->
            <Border Classes="panel" x:Name="PanelSettings" IsVisible="False" Margin="32">
              <views:SettingsView x:Name="SettingsTab" />
            </Border>

          </Grid>
        </ScrollViewer>

      </Grid>

    </Grid>

  </Border>
</Window>
