<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AndroidManager.Views.AppsView">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8" RowSpacing="6">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
      <TextBlock Grid.Column="0" Text="Фильтр:" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="FilterBox" />
      <ComboBox Grid.Column="2" x:Name="ScopeBox" Width="190" />
      <Button Grid.Column="3" x:Name="RefreshBtn" Content="Обновить" Classes="btn--primary" />
    </Grid>

    <TextBlock Grid.Row="1" x:Name="CountLabel" Text="Приложения не загружены"
               Foreground="{DynamicResource Muted}" />

    <!-- Установка APK с диска: список из папки apk рядом с exe -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
      <TextBlock Grid.Column="0" Text="APK:" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="ApkBox" HorizontalAlignment="Stretch"
                PlaceholderText="В папке apk нет файлов — добавьте с диска" />
      <Button Grid.Column="2" x:Name="AddApkBtn" Content="Добавить с диска" Classes="btn--ghost"
              ToolTip.Tip="Скопировать APK в папку apk рядом с программой" />
      <Button Grid.Column="3" x:Name="InstallApkBtn" Content="Установить" Classes="btn--primary"
              ToolTip.Tip="Установить выбранный APK на устройство (adb install -r)" />
      <Button Grid.Column="4" x:Name="OpenApkFolderBtn" Content="Папка APK" Classes="btn--ghost"
              ToolTip.Tip="Открыть папку apk в проводнике" />
    </Grid>

    <!-- Кастомные кнопки этой вкладки: «+ Кнопка» создаёт, ПКМ — изменить/удалить -->
    <WrapPanel Grid.Row="3" x:Name="CustomBar" Orientation="Horizontal" />

    <Border Grid.Row="4" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10"
            ClipToBounds="True" MaxHeight="420">
      <ListBox x:Name="PkgList" SelectionMode="Multiple" />
    </Border>

    <WrapPanel Grid.Row="5" Orientation="Horizontal">
      <Button x:Name="RunBtn" Content="Запустить" Margin="0,0,6,0" />
      <Button x:Name="StopBtn" Content="Закрыть" Margin="0,0,6,0" />
      <Button x:Name="ClearBtn" Content="Очистить данные" Margin="0,0,6,0" />
      <Button x:Name="DisableBtn" Content="Отключить" Margin="0,0,6,0" />
      <Button x:Name="EnableBtn" Content="Включить" Margin="0,0,6,0" />
      <Button x:Name="UninstallBtn" Content="Удалить" Margin="0,0,6,0" />
    </WrapPanel>
  </Grid>
</UserControl>