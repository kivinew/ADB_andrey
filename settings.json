  "bars": {
    "tools": [],
    "console": [
      {
        "name": "logcat (300)",
        "cmd": "logcat -d -t 300",
        "type": "shell"
      },
      {
        "name": "dmesg (хвост)",
        "cmd": "dmesg | tail -200",
        "type": "shell"
      },
      {
        "name": "Процессы",
        "cmd": "ps -A",
        "type": "shell"
      },
      {
        "name": "Сеть",
        "cmd": "ip addr",
        "type": "shell"
      },
      {
        "name": "Диск",
        "cmd": "df",
        "type": "shell"
      }
    ],
    "scripts": [
      {
        "name": "Сводка устройства (Python)",
        "kind": "script",
        "file": "сводка_устройства_python.py"
      },
      {
        "name": "Закрыть пользовательские (Python)",
        "kind": "script",
        "file": "закрыть_пользовательские_python.py"
      }
    ],
    "apps": [
      {
        "name": "Запустить",
        "cmd": "monkey -p {pkg} -c android.intent.category.LAUNCHER 1",
        "per_pkg": true
      },
      {
        "name": "Закрыть (force-stop)",
        "cmd": "am force-stop {pkg}",
        "per_pkg": true
      },
      {
        "name": "Очистить данные и кэш",
        "cmd": "pm clear {pkg}",
        "per_pkg": true
      },
      {
        "name": "Удалить (user 0)",
        "cmd": "pm uninstall -k --user 0 {pkg}",
        "per_pkg": true
      },
      {
        "name": "Отключить",
        "cmd": "pm disable-user --user 0 {pkg}",
        "per_pkg": true
      },
      {
        "name": "Включить",
        "cmd": "pm enable --user 0 {pkg}",
        "per_pkg": true
      },
      {
        "name": "Информация",
        "cmd": "dumpsys package {pkg} | grep -E \"versionName|codePath|firstInstallTime\"",
        "per_pkg": true
      },
      {
        "name": "Закрыть все пользовательские",
        "per_pkg": false,
        "cmd": "for p in $(pm list packages -3 | cut -d \":\" -f2); do am force-stop $p; done; echo готово"
      }
    ]
  },
