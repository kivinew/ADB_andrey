  "remote_current": "Android TV (стандартный)",
  "cards": [
    {
      "id": "ram",
      "title": "Оперативная память",
      "parse": "nums_pct",
      "a": 1,
      "b": 0,
      "div": 1024,
      "unit": "МБ",
      "max": 100,
      "cmd": "awk '/^MemTotal/{t=$2}/^MemAvailable/{a=$2}END{print t, t-a}' /proc/meminfo"
    },
    {
      "id": "disk",
      "title": "Внутренняя память (/data)",
      "parse": "nums_pct",
      "a": 0,
      "b": 1,
      "div": 1024,
      "unit": "МБ",
      "max": 100,
      "cmd": "df -k /data | tail -1 | awk '{print $3, $2}'"
    },
    {
      "id": "cpu",
      "title": "Процессор (CPU)",
      "parse": "cpu",
      "unit": "%",
      "max": 100,
      "cmd": "",
      "div": 1
    },
    {
      "id": "gpu",
      "title": "Видеопроцессор (GPU)",
      "parse": "number",
      "idx": 0,
      "div": 1,
      "unit": "%",
      "max": 100,
      "cmd": "for f in /sys/class/mpgpu/utilization /sys/class/gpu/utilization /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage; do [ -r \"$f\" ] && cat \"$f\" && break; done 2>/dev/null || echo 0"
    },
    {
      "id": "temp",
      "title": "Температура",
      "parse": "number",
      "idx": 0,
      "div": 1,
      "unit": "°C",
      "max": 100,
      "cmd": "dumpsys battery 2>/dev/null | grep temperature | sed 's/temperature: //'"
    },
    {
      "id": "load",
      "title": "Нагрузка CPU (1 мин)",
      "parse": "number",
      "idx": 0,
      "div": 100,
      "unit": "",
      "max": 100,
      "cmd": "cat /proc/loadavg 2>/dev/null | awk '{print $1*100}' || echo 0"
    }
  ],
  "scrcpy": {
    "max_size": "1920",
    "fps": "60",
    "bitrate": "8M",
    "codec": "h264",
    "show_touches": false,
    "stay_awake": true,
    "screen_off": false
  }
